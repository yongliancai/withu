# ===== 必填 =====
# 你的網域（先在 DNS 把 A 記錄指到 VPS 的 IP）
DOMAIN=app.example.com
PUBLIC_URL=https://app.example.com

# OpenAI API 金鑰（不填就會進入測試模式，回覆是範例文字）
OPENAI_API_KEY=

# 測試者邀請碼，可以多組，用逗號分開
# 女性向測試群組（預設遇見男生）；舊的 INVITE_CODES 也還是算女性向
INVITE_CODES_F=TEST2026
# 男性向測試群組（預設遇見女生）
INVITE_CODES_M=

# 後台 /admin 的密碼（請改成一長串亂碼）
ADMIN_TOKEN=change-me-to-a-long-random-string

# 推播用的金鑰：執行 `docker compose run --rm app node scripts/gen-vapid.js` 產生後貼上
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ===== 模型（可不改）=====
MODEL_CHEAP=gpt-5.4-mini
MODEL_GOOD=gpt-5.5
REASONING_CHEAP=none
REASONING_GOOD=low
TTS_MODEL=gpt-4o-mini-tts
STT_MODEL=gpt-4o-mini-transcribe

# 後台成本估算用的單價（USD / 1M tokens），價格變動時更新
PRICE_CHEAP_IN=0.75
PRICE_CHEAP_CACHED=0.075
PRICE_CHEAP_OUT=4.5
PRICE_GOOD_IN=5
PRICE_GOOD_CACHED=0.5
PRICE_GOOD_OUT=30
PRICE_TTS_PER_1K_CHARS=0.015
PRICE_STT_PER_MIN=0.003
USD_TWD=32

# ===== 產品參數（可不改）=====
# 同時往來角色上限（測試版不分級）
MAX_ACTIVE_RELATIONSHIPS=5
# 他每天最多傳幾則語音（所有角色合計）
VOICE_DAILY_CAP=4
# 關係推進速度，1 = 正常；示範時可設 4 讓關係變快
STAGE_SPEED=1
# 下單方式：redirect = 跳轉 Uber Eats（目前唯一可用）
ORDER_MODE=redirect
